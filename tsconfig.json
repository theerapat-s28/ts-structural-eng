{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "types": ["node"],

    /* Output Options */
    "sourceMap": true,
    "declaration": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,

    /* Module Resolution */
    "esModuleInterop": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "./",
    "paths": {
      "@app-core/*": ["src/core/*"],
      "@app-types/*": ["src/core/types/*"],
      "@app-utils/*": ["src/utils/*"],
      "@app-rc/*": ["src/rc/*"],
      "@app-strg/*": ["src/strengthening/*"]
    },
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
