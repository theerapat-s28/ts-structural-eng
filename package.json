{
  "name": "@theerapat-s28/ts-structural-eng-tools",
  "version": "2.0.0",
  "description": "TypeScript structural-engineering helper functions and beam design utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rc": {
      "types": "./dist/rc/index.d.ts",
      "import": "./dist/esm/rc/index.js",
      "require": "./dist/rc/index.js",
      "default": "./dist/rc/index.js"
    },
    "./strengthening": {
      "types": "./dist/strengthening/index.d.ts",
      "import": "./dist/esm/strengthening/index.js",
      "require": "./dist/strengthening/index.js",
      "default": "./dist/strengthening/index.js"
    },
    "./fea": {
      "types": "./dist/fea/index.d.ts",
      "import": "./dist/esm/fea/index.js",
      "require": "./dist/fea/index.js",
      "default": "./dist/fea/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register examples/basic-usage.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json --resolve-full-paths && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }))\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "structural-engineering",
    "beam-design",
    "reinforced-concrete",
    "ACI-318",
    "moment-capacity",
    "steel-jacketing",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "homepage": "https://theerapat-s28.github.io/ts-structural-eng/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theerapat-s28/ts-structural-eng.git"
  },
  "bugs": {
    "url": "https://github.com/theerapat-s28/ts-structural-eng/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.20.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.0"
  }
}
